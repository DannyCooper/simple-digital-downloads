{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "simple-digital-downloads/buy-button",
	"version": "1.0.0",
	"title": "Buy Button",
	"category": "widgets",
	"icon": "cart",
	"description": "Add a buy button for a digital download.",
	"textdomain": "simple-digital-downloads",
	"attributes": {
		"downloadId": {
			"type": "number",
			"default": 0
		},
		"buttonText": {
			"type": "string",
			"default": ""
		},
		"showPrice": {
			"type": "boolean",
			"default": true
		},
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "1rem",
						"right": "1rem",
						"bottom": "1rem",
						"left": "1rem"
					}
				},
				"typography": {
					"fontWeight": "700"
				}
			}
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "left", "center", "right", "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true,
			"defaultControls": {
				"margin": true,
				"padding": true
			},
			"__experimentalDefaultControls": {
				"margin": true,
				"padding": true
			}
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": true,
			"link": false,
			"button": false,
			"heading": false,
			"defaultControls": {
				"text": true,
				"background": true
			},
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": true,
			"fontWeight": true,
			"fontStyle": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextDecoration": true,
			"__experimentalTextTransform": true,
			"defaultControls": {
				"fontSize": true,
				"fontFamily": true,
				"fontWeight": true,
				"lineHeight": true
			},
			"__experimentalDefaultControls": {
				"fontSize": true,
				"__experimentalFontFamily": true,
				"__experimentalFontWeight": true,
				"lineHeight": true
			}
		},
		"border": {
			"color": true,
			"radius": true,
			"width": true,
			"style": true,
			"defaultControls": {
				"color": true,
				"radius": true,
				"width": true,
				"style": true
			}
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"width": true,
				"style": true
			}
		},
		"shadow": true,
		"dimensions": {
			"minHeight": true,
			"defaultControls": {
				"minHeight": true
			},
			"__experimentalDefaultControls": {
				"minHeight": true
			}
		},
		"position": {
			"sticky": true
		}
	},
	"styles": [
		{
			"name": "light",
			"label": "Light",
			"isDefault": true
		},
		{
			"name": "dark",
			"label": "Dark"
		}
	],
	"selectors": {
		"root": ".wp-block-simple-digital-downloads-buy-button.sdd-buy-button"
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"viewStyle": "file:./view.css",
	"render": "file:./render.php"
}
